<?xml version="1.0" encoding="UTF-8"?>
<!--
  TOCA Sitemap
  Replace https://www.toca.co.za with your actual domain before deploying.

  Only pages meant for search results are listed here. Transactional/private
  pages (cart, checkout, account, track, unsubscribe) and the admin portal
  carry <meta name="robots" content="noindex"> and are deliberately excluded
  — see robots.txt.

  Product pages (product-detail.html?id=...) are dynamically rendered from
  a query-string ID rather than a static slug, so they can't be listed as
  fixed URLs here. Each product page sets its own canonical URL and Product
  JSON-LD client-side (js/product-detail.js). To get individual products
  into this sitemap, generate a sitemap-products.xml server-side from the
  product catalog (one <url> per product ID) and reference it from a
  sitemap index alongside this file.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">

  <url>
    <loc>https://www.toca.co.za/</loc>
    <lastmod>2026-08-07</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://www.toca.co.za/shop.html</loc>
    <lastmod>2026-08-07</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://www.toca.co.za/guide.html</loc>
    <lastmod>2026-08-07</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>

  <url>
    <loc>https://www.toca.co.za/quotes.html</loc>
    <lastmod>2026-08-07</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>

</urlset>
