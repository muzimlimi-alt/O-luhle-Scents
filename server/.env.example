# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/toca"

# Server
PORT=3000
FRONTEND_URL="http://127.0.0.1:5500"
SERVER_URL="http://localhost:3000"

# Set to true only if this server is genuinely fronted by a reverse proxy or
# tunnel (production behind nginx/Azure, or local dev behind ngrok/similar).
# Required for PayFast's ITN IP allowlist to see the real client IP instead
# of the proxy's — leave unset/false for a bare server reachable directly.
TRUST_PROXY=false

# JWT
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# PayFast — get these from your PayFast merchant account
# Sandbox: https://sandbox.payfast.co.za  |  Live: https://www.payfast.co.za
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"
