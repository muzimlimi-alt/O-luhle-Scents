generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 1. ADMIN_USERS ──────────────────────────────────────────────────────────
model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(100)
  email        String         @unique @db.VarChar(150)
  passwordHash String         @map("password_hash")
  role         String         @default("admin") @db.VarChar(50)
  isActive     Boolean        @default(true) @map("is_active")
  lastLogin    DateTime?      @map("last_login")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  newsletterCampaigns NewsletterCampaign[]
  returnItems  ReturnItem[]

  @@map("admin_users")
}

// ── 2. ADMIN_SESSIONS ────────────────────────────────────────────────────────
model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  token       String
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ── 3. PRODUCTS ─────────────────────────────────────────────────────────────
enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// PIM Phase 1: which attribute set a product belongs to. Drives which
// AttributeDefinition rows apply once the family-aware admin UI (Phase 2)
// exists. Existing catalogue defaults to PERFUME so nothing changes today.
enum ProductFamily {
  PERFUME
  CANDLE
  HOME_FRAGRANCE
  ACCESSORY
  GIFT_SET
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(150)
  brand       String?          @db.VarChar(100)
  description String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  categoryId  String?          @map("category_id") @db.Uuid
  status      ProductStatus    @default(ACTIVE)
  images       String?          // JSON array of filenames
  primaryImage String?         @map("primary_image")
  cardBadge    String?         @map("card_badge") @db.VarChar(50)
  supplierId   String?          @map("supplier_id") @db.Uuid

  // NEW: Aromatic & Sensory Fields
  collection      String?         @db.VarChar(150)
  type            String?         @db.VarChar(150)
  oilConcentration String?        @map("oil_concentration") @db.VarChar(150)
  longevity       String?         @db.VarChar(150)
  scentFamily     String?         @map("scent_family") @db.VarChar(150)
  characteristic  String?         @db.VarChar(150)
  topNotes        String?         @map("top_notes") @db.Text
  heartNotes      String?         @map("heart_notes") @db.Text
  baseNotes       String?         @map("base_notes") @db.Text

  // ── PIM Phase 1: identity, taxonomy & SEO ──────────────────────────────────
  internalName    String?        @map("internal_name") @db.VarChar(150)
  slug            String?        @unique @db.VarChar(180)
  brandId         String?        @map("brand_id") @db.Uuid
  brandRef        Brand?         @relation(fields: [brandId], references: [id])
  family          ProductFamily  @default(PERFUME)
  tags            String[]       @default([])
  launchDate      DateTime?      @map("launch_date")
  retirementDate  DateTime?      @map("retirement_date")

  shortDescription     String?   @map("short_description")
  marketingDescription String?   @map("marketing_description")
  ingredients          String?
  usageInstructions    String?   @map("usage_instructions")
  safetyWarnings       String?   @map("safety_warnings")
  careInstructions     String?   @map("care_instructions")

  metaTitle       String?        @map("meta_title") @db.VarChar(70)
  metaDescription String?        @map("meta_description") @db.VarChar(180)

  attributeValues ProductAttributeValue[]
  alternativeSuppliers ProductSupplier[]
  media ProductMedia[]

  supplier    Supplier?        @relation(fields: [supplierId], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  variants    ProductVariant[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([brandId])
  @@index([family])
  @@map("products")
}

// ── 3b. BRANDS ───────────────────────────────────────────────────────────────
// First-class brand entity. Product.brand (free text) is left untouched for
// backward compatibility; brandId/brandRef is the new authoritative link,
// backfilled from the distinct existing brand strings — see phase-1 backfill.
model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("brands")
}

// ── 3c. ATTRIBUTE DEFINITIONS ─────────────────────────────────────────────────
// PIM Phase 1 ships the schema only — empty, unused by the existing perfume
// catalogue. Phase 2 introduces the admin UI and the CANDLE attribute set.
model AttributeDefinition {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique @db.VarChar(60)
  label            String   @db.VarChar(120)
  family           ProductFamily
  dataType         String   @db.VarChar(20) // TEXT | NUMBER | ENUM | BOOLEAN
  unit             String?  @db.VarChar(20)
  options          Json?
  appliesToVariant Boolean  @default(false) @map("applies_to_variant")
  isFilterable     Boolean  @default(false) @map("is_filterable")
  displayOrder     Int      @default(0) @map("display_order")
  createdAt        DateTime @default(now()) @map("created_at")

  productValues ProductAttributeValue[]
  variantValues VariantAttributeValue[]

  @@index([family])
  @@map("attribute_definitions")
}

model ProductAttributeValue {
  id           String              @id @default(uuid()) @db.Uuid
  productId    String              @map("product_id") @db.Uuid
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String              @map("definition_id") @db.Uuid
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String

  @@unique([productId, definitionId])
  @@index([definitionId, value])
  @@map("product_attribute_values")
}

model VariantAttributeValue {
  id           String              @id @default(uuid()) @db.Uuid
  variantId    String              @map("variant_id") @db.Uuid
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  definitionId String              @map("definition_id") @db.Uuid
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String

  @@unique([variantId, definitionId])
  @@map("variant_attribute_values")
}

// ── MEDIA LIBRARY ─────────────────────────────────────────────────────────────
// Additive: mirrors Product.images/primaryImage rather than replacing them,
// so the storefront and existing admin gallery keep working unchanged.
// The concrete new capability this adds is structured metadata — alt text —
// which a bare JSON filename array can never carry.
model MediaAsset {
  id         String   @id @default(uuid()) @db.Uuid
  filename   String   @db.VarChar(255)
  storageKey String   @unique @map("storage_key") @db.VarChar(500)
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  mediaType  String   @default("IMAGE") @map("media_type") @db.VarChar(20) // IMAGE | VIDEO | DOCUMENT | CERTIFICATE
  sizeBytes  Int?     @map("size_bytes")
  width      Int?
  height     Int?
  altText    String?  @map("alt_text") @db.VarChar(255)
  provider   String   @default("local") @db.VarChar(30) // local | azure_blob
  createdAt  DateTime @default(now()) @map("created_at")

  productMedia ProductMedia[]

  @@map("media_assets")
}

model ProductMedia {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String         @map("media_id") @db.Uuid
  media     MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  variantId String?        @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  role      String         @default("GALLERY") @db.VarChar(20) // GALLERY | LIFESTYLE | 360 | THUMBNAIL
  sortOrder Int            @default(0) @map("sort_order")
  isPrimary Boolean        @default(false) @map("is_primary")
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@map("product_media")
}

// ── 4. PRODUCT_VARIANTS ──────────────────────────────────────────────────────
model ProductVariant {
  id            String         @id @default(uuid()) @db.Uuid
  productId     String         @map("product_id") @db.Uuid
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String         @db.VarChar(20)
  price         Decimal        @db.Decimal(10, 2)
  costPrice     Decimal?       @map("cost_price") @db.Decimal(10, 2)
  sku           String         @unique @db.VarChar(100)
  barcode       String?        @db.VarChar(100)

  // NEW: Logistical Fields
  uom           String         @default("ml") @db.VarChar(20)
  volume        Int            @default(0)
  weightGrams   Int?           @map("weight_grams")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  inventory     Inventory?
  inventoryLogs InventoryLog[]
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  quoteItems    QuoteItem[]
  reservations  InventoryReservation[]
  attributeValues VariantAttributeValue[]
  media ProductMedia[]

  @@index([productId])
  @@map("product_variants")
}

// ── 5. INVENTORY ─────────────────────────────────────────────────────────────
model Inventory {
  id                 String         @id @default(uuid()) @db.Uuid
  variantId          String         @unique @map("variant_id") @db.Uuid
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity           Int            @default(0)
  reserved           Int            @default(0)
  lowStockThreshold  Int            @default(5) @map("low_stock_threshold")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@map("inventory")
}

// ── 5b. INVENTORY_RESERVATIONS ────────────────────────────────────────────────
// A hold placed on stock between order creation and payment confirmation.
// Prevents the oversell race: quantity is only decremented on payment; until
// then, `reserved` narrows what other checkouts see as available.
model InventoryReservation {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId    String         @map("order_id") @db.Uuid
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity   Int
  expiresAt  DateTime       @map("expires_at")
  consumedAt DateTime?      @map("consumed_at")
  releasedAt DateTime?      @map("released_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([variantId])
  @@index([orderId])
  @@index([expiresAt, consumedAt, releasedAt])
  @@map("inventory_reservations")
}

// ── 6. INVENTORY_LOGS ────────────────────────────────────────────────────────
model InventoryLog {
  id              String         @id @default(uuid()) @db.Uuid
  variantId       String         @map("variant_id") @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  changeType      String         @map("change_type") @db.VarChar(20) // add/remove/sale/return
  quantityChanged Int            @map("quantity_changed")
  reason          String?
  referenceId     String?        @map("reference_id") @db.Uuid // link to order/purchase
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@index([referenceId])
  @@map("inventory_logs")
}

// ── 7. CUSTOMERS ─────────────────────────────────────────────────────────────
model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String?   @db.VarChar(100)
  email     String?   @unique @db.VarChar(150)
  phone     String?   @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  addresses Address[]
  orders    Order[]
  quotes    Quote[]

  @@map("customers")
}

// ── 8. ADDRESSES ─────────────────────────────────────────────────────────────
model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street     String?
  city       String?  @db.VarChar(100)
  province   String?  @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  country    String?  @db.VarChar(100)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  orders     Order[]

  @@index([customerId])
  @@map("addresses")
}

// ── 9. ORDERS ────────────────────────────────────────────────────────────────
model Order {
  id                String      @id @default(uuid()) @db.Uuid
  customerId        String?     @map("customer_id") @db.Uuid
  customer          Customer?   @relation(fields: [customerId], references: [id])
  status            String      @default("pending") @db.VarChar(30)
  paymentStatus     String      @default("unpaid") @map("payment_status") @db.VarChar(30)
  totalAmount       Decimal     @map("total_amount") @db.Decimal(10, 2)
  shippingCost      Decimal     @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  shippingAddressId String?     @map("shipping_address_id") @db.Uuid
  shippingAddress   Address?    @relation(fields: [shippingAddressId], references: [id])
  
  // Logistics Overhaul
  trackingNumber    String?     @map("tracking_number") @db.VarChar(100)
  courierName       String?     @map("courier_name") @db.VarChar(100)
  shippingStatus    String?     @map("shipping_status") @db.VarChar(50)
  shippedAt         DateTime?   @map("shipped_at")
  estimatedDelivery DateTime?   @map("estimated_delivery")
  logisticsEvents   LogisticsEvent[]

  // Quote Integration
  quoteId           String?     @unique @map("quote_id") @db.Uuid
  quote             Quote?      @relation(fields: [quoteId], references: [id])

  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  items             OrderItem[]
  payments          Payment[]
  invoices          Invoice[]
  reservations      InventoryReservation[]
  abandonedEmailSent Boolean     @default(false) @map("abandoned_email_sent")

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

// ── 10. ORDER_ITEMS ──────────────────────────────────────────────────────────
model OrderItem {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String?        @map("variant_id") @db.Uuid
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  quantity        Int
  priceAtPurchase Decimal        @map("price_at_purchase") @db.Decimal(10, 2)
  returnItems     ReturnItem[]

  // PIM Phase 1: frozen at line-item creation so a renamed/deleted product or
  // variant never rewrites what a historical order/invoice was actually for.
  // Nullable so pre-existing rows fall back to the live relation unchanged.
  productNameSnapshot  String?  @map("product_name_snapshot")
  variantLabelSnapshot String?  @map("variant_label_snapshot")
  skuSnapshot          String?  @map("sku_snapshot")
  costAtPurchase       Decimal? @map("cost_at_purchase") @db.Decimal(10, 2)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ── 10b. RETURN_ITEMS ────────────────────────────────────────────────────────
// A customer return, inspected and dispositioned to one of two outcomes:
// good condition (restocked, ledgered via InventoryLog through adjustStock)
// or damaged (written off — no inventory change, this row is the only record).
model ReturnItem {
  id          String     @id @default(uuid()) @db.Uuid
  orderItemId String     @map("order_item_id") @db.Uuid
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  condition   String     @db.VarChar(20) // GOOD | DAMAGED
  restocked   Boolean    @default(false)
  note        String?
  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([orderItemId])
  @@map("return_items")
}

// ── 11. PAYMENTS ─────────────────────────────────────────────────────────────
model Payment {
  id                   String    @id @default(uuid()) @db.Uuid
  orderId              String    @map("order_id") @db.Uuid
  order                Order     @relation(fields: [orderId], references: [id])
  paymentMethod        String?   @map("payment_method") @db.VarChar(50)
  paymentStatus        String?   @map("payment_status") @db.VarChar(30)
  transactionReference String?   @unique @map("transaction_reference") @db.VarChar(150)
  amount               Decimal?  @db.Decimal(10, 2)
  paidAt               DateTime? @map("paid_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}

// ── 12. INVOICES ─────────────────────────────────────────────────────────────
model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id])
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(100)
  issuedDate    DateTime @default(now()) @map("issued_date")
  pdfUrl        String?  @map("pdf_url")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("invoices")
}

// ── 13. COUPONS ──────────────────────────────────────────────────────────────
model Coupon {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique @db.VarChar(50)
  discountType String?   @map("discount_type") @db.VarChar(20)
  value        Decimal?  @db.Decimal(10, 2)
  expiryDate   DateTime? @map("expiry_date")
  usageLimit   Int?      @map("usage_limit")
  usedCount    Int       @default(0) @map("used_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("coupons")
}

// ── 14. SUPPLIERS ────────────────────────────────────────────────────────────
model Supplier {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(150)
  contactEmail String?    @map("contact_email") @db.VarChar(150)
  phone        String?    @db.VarChar(20)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  purchases    Purchase[]
  products     Product[]
  productSuppliers ProductSupplier[]

  @@map("suppliers")
}

// ── 14b. PRODUCT_SUPPLIERS ────────────────────────────────────────────────────
// Alternative suppliers for a product. Product.supplierId remains the
// fast-path primary supplier for the common single-supplier case; this table
// is purely additive for products that need alternates.
model ProductSupplier {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String   @map("supplier_id") @db.Uuid
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku  String?  @map("supplier_sku") @db.VarChar(100)
  leadTimeDays Int?     @map("lead_time_days")
  minOrderQty  Int?     @map("min_order_qty")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// ── 15. PURCHASES ────────────────────────────────────────────────────────────
model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  supplierId        String?        @map("supplier_id") @db.Uuid
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  totalCost         Decimal?       @map("total_cost") @db.Decimal(10, 2)
  status            String         @default("PENDING") @db.VarChar(30)
  expectedDelivery  DateTime?      @map("expected_delivery")
  receivedAt        DateTime?      @map("received_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  items             PurchaseItem[]

  @@map("purchases")
}

// ── 16. PURCHASE_ITEMS ───────────────────────────────────────────────────────
model PurchaseItem {
  id         String         @id @default(uuid()) @db.Uuid
  purchaseId String         @map("purchase_id") @db.Uuid
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String         @map("variant_id") @db.Uuid
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  costPrice  Decimal        @map("cost_price") @db.Decimal(10, 2)

  @@map("purchase_items")
}

// ── 17. NOTIFICATIONS ────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @db.VarChar(50)
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ── 18. AUDIT_LOGS ───────────────────────────────────────────────────────────
model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String     @db.VarChar(100)
  entity      String     @db.VarChar(50)
  entityId    String?    @map("entity_id") @db.Uuid
  details     Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([adminUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── 19. GLOBAL_SETTINGS ──────────────────────────────────────────────────────
model GlobalSetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(100)
  value String
  group String @default("general") @db.VarChar(50)

  @@map("global_settings")
}

// ── 20. CURRENCY_RATES ───────────────────────────────────────────────────────
model CurrencyRate {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(10) // USD, EUR, etc.
  rate         Decimal  @db.Decimal(18, 6) // Rate relative to ZAR baseline
  lastUpdate   DateTime @default(now()) @map("last_update")

  @@map("currency_rates")
}

// ── 21. SHIPPING_ZONES ───────────────────────────────────────────────────────
model ShippingZone {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(100)
  country    String?  @db.VarChar(100)
  postalPattern String? @map("postal_pattern") @db.VarChar(255)
  baseRate   Decimal  @map("base_rate") @db.Decimal(10, 2)
  freeAbove  Decimal? @map("free_above") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("shipping_zones")
}

// ── 22. LOGISTICS_EVENTS ─────────────────────────────────────────────────────
model LogisticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String   @db.VarChar(50) // PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED
  message   String?
  location  String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("logistics_events")
}

// ── 23. QUOTES ───────────────────────────────────────────────────────────────
model Quote {
  id           String      @id @default(uuid()) @db.Uuid
  quoteNumber  String      @unique @map("quote_number") @db.VarChar(100)
  customerId   String?     @map("customer_id") @db.Uuid
  customer     Customer?   @relation(fields: [customerId], references: [id])
  status       String      @default("draft") @db.VarChar(30) // draft, sent, approved, rejected, expired, converted
  totalAmount  Decimal     @map("total_amount") @db.Decimal(10, 2)
  expiryDate   DateTime?   @map("expiry_date")
  notes        String?
  pdfUrl       String?     @map("pdf_url")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  items        QuoteItem[]
  order        Order?

  @@index([customerId, status])
  @@index([status, expiryDate])
  @@map("quotes")
}

// ── 24. QUOTE_ITEMS ──────────────────────────────────────────────────────────
model QuoteItem {
  id           String         @id @default(uuid()) @db.Uuid
  quoteId      String         @map("quote_id") @db.Uuid
  quote        Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variantId    String?        @map("variant_id") @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  quantity     Int
  priceAtQuote Decimal        @map("price_at_quote") @db.Decimal(10, 2)

  // PIM Phase 1: see OrderItem — same snapshot rationale.
  productNameSnapshot  String? @map("product_name_snapshot")
  variantLabelSnapshot String? @map("variant_label_snapshot")
  skuSnapshot          String? @map("sku_snapshot")

  @@map("quote_items")
}

// ── 25. CATEGORIES ───────────────────────────────────────────────────────────
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?
  image       String?
  displayOrder Int      @default(0) @map("display_order")
  isActive    Boolean   @default(true) @map("is_active")
  parentId    String?   @map("parent_id") @db.Uuid
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@index([parentId, displayOrder])
  @@map("categories")
}

// ── 26. SUBSCRIBERS ──────────────────────────────────────────────────────────
model Subscriber {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(150)
  status           String    @default("active") @db.VarChar(20)  // active | unsubscribed
  source           String    @default("frontend") @db.VarChar(50) // frontend | checkout | admin
  unsubscribeToken String?   @unique @map("unsubscribe_token") @db.VarChar(128)
  tokenExpiresAt   DateTime? @map("token_expires_at")             // token TTL (90 days)
  addedBy          String?   @map("added_by") @db.VarChar(150)   // admin name/id who created entry
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscribers")
}

// ── 27. NEWSLETTER_CAMPAIGNS ──────────────────────────────────────────────────
model NewsletterCampaign {
  id          String     @id @default(uuid()) @db.Uuid
  subject     String     @db.VarChar(200)
  contentHtml String     @map("content_html") @db.Text
  status      String     @default("draft") @db.VarChar(20) // draft, sent, failed
  sentAt      DateTime?  @map("sent_at")
  sentCount   Int        @default(0) @map("sent_count")
  attachments Json?      // Store { filename, path, mimetype, size }
  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("newsletter_campaigns")
}
