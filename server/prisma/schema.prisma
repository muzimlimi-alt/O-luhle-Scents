generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 1. ADMIN_USERS ──────────────────────────────────────────────────────────
model AdminUser {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  email               String               @unique @db.VarChar(150)
  passwordHash        String               @map("password_hash")
  role                String               @default("admin") @db.VarChar(50)
  isActive            Boolean              @default(true) @map("is_active")
  lastLogin           DateTime?            @map("last_login")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  sessions            AdminSession[]
  auditLogs           AuditLog[]
  newsletterCampaigns NewsletterCampaign[]
  returnItems         ReturnItem[]
  refunds             Refund[]
  verifiedPayments    Payment[]
  supplierPayments    SupplierPayment[]
  expenses            Expense[]
  assets              Asset[]
  approvalRequestsMade    ApprovalRequest[] @relation("ApprovalRequested")
  approvalRequestsDecided ApprovalRequest[] @relation("ApprovalDecided")

  @@map("admin_users")
}

// ── 2. ADMIN_SESSIONS ────────────────────────────────────────────────────────
model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  token       String
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ── 3. PRODUCTS ─────────────────────────────────────────────────────────────
enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// PIM Phase 1: which attribute set a product belongs to. Drives which
// AttributeDefinition rows apply once the family-aware admin UI (Phase 2)
// exists. Existing catalogue defaults to PERFUME so nothing changes today.
enum ProductFamily {
  PERFUME
  CANDLE
  HOME_FRAGRANCE
  ACCESSORY
  GIFT_SET
}

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(150)
  brand        String?       @db.VarChar(100)
  description  String?
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?       @map("category_id") @db.Uuid
  status       ProductStatus @default(ACTIVE)
  images       String? // JSON array of filenames
  primaryImage String?       @map("primary_image")
  cardBadge    String?       @map("card_badge") @db.VarChar(50)
  supplierId   String?       @map("supplier_id") @db.Uuid

  // NEW: Aromatic & Sensory Fields
  collection       String? @db.VarChar(150)
  type             String? @db.VarChar(150)
  oilConcentration String? @map("oil_concentration") @db.VarChar(150)
  longevity        String? @db.VarChar(150)
  scentFamily      String? @map("scent_family") @db.VarChar(150)
  characteristic   String? @db.VarChar(150)
  topNotes         String? @map("top_notes") @db.Text
  heartNotes       String? @map("heart_notes") @db.Text
  baseNotes        String? @map("base_notes") @db.Text

  // ── PIM Phase 1: identity, taxonomy & SEO ──────────────────────────────────
  internalName   String?       @map("internal_name") @db.VarChar(150)
  slug           String?       @unique @db.VarChar(180)
  brandId        String?       @map("brand_id") @db.Uuid
  brandRef       Brand?        @relation(fields: [brandId], references: [id])
  family         ProductFamily @default(PERFUME)
  tags           String[]      @default([])
  launchDate     DateTime?     @map("launch_date")
  retirementDate DateTime?     @map("retirement_date")

  shortDescription     String? @map("short_description")
  marketingDescription String? @map("marketing_description")
  ingredients          String?
  usageInstructions    String? @map("usage_instructions")
  safetyWarnings       String? @map("safety_warnings")
  careInstructions     String? @map("care_instructions")

  metaTitle       String? @map("meta_title") @db.VarChar(70)
  metaDescription String? @map("meta_description") @db.VarChar(180)

  attributeValues      ProductAttributeValue[]
  alternativeSuppliers ProductSupplier[]
  media                ProductMedia[]

  supplier  Supplier?        @relation(fields: [supplierId], references: [id])
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  variants  ProductVariant[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([brandId])
  @@index([family])
  @@map("products")
}

// ── 3b. BRANDS ───────────────────────────────────────────────────────────────
// First-class brand entity. Product.brand (free text) is left untouched for
// backward compatibility; brandId/brandRef is the new authoritative link,
// backfilled from the distinct existing brand strings — see phase-1 backfill.
model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("brands")
}

// ── 3c. ATTRIBUTE DEFINITIONS ─────────────────────────────────────────────────
// PIM Phase 1 ships the schema only — empty, unused by the existing perfume
// catalogue. Phase 2 introduces the admin UI and the CANDLE attribute set.
model AttributeDefinition {
  id               String        @id @default(uuid()) @db.Uuid
  key              String        @unique @db.VarChar(60)
  label            String        @db.VarChar(120)
  family           ProductFamily
  dataType         String        @db.VarChar(20) // TEXT | NUMBER | ENUM | BOOLEAN
  unit             String?       @db.VarChar(20)
  options          Json?
  appliesToVariant Boolean       @default(false) @map("applies_to_variant")
  isFilterable     Boolean       @default(false) @map("is_filterable")
  displayOrder     Int           @default(0) @map("display_order")
  createdAt        DateTime      @default(now()) @map("created_at")

  productValues ProductAttributeValue[]
  variantValues VariantAttributeValue[]

  @@index([family])
  @@map("attribute_definitions")
}

model ProductAttributeValue {
  id           String              @id @default(uuid()) @db.Uuid
  productId    String              @map("product_id") @db.Uuid
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String              @map("definition_id") @db.Uuid
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String

  @@unique([productId, definitionId])
  @@index([definitionId, value])
  @@map("product_attribute_values")
}

model VariantAttributeValue {
  id           String              @id @default(uuid()) @db.Uuid
  variantId    String              @map("variant_id") @db.Uuid
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  definitionId String              @map("definition_id") @db.Uuid
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String

  @@unique([variantId, definitionId])
  @@map("variant_attribute_values")
}

// ── MEDIA LIBRARY ─────────────────────────────────────────────────────────────
// Additive: mirrors Product.images/primaryImage rather than replacing them,
// so the storefront and existing admin gallery keep working unchanged.
// The concrete new capability this adds is structured metadata — alt text —
// which a bare JSON filename array can never carry.
model MediaAsset {
  id         String   @id @default(uuid()) @db.Uuid
  filename   String   @db.VarChar(255)
  storageKey String   @unique @map("storage_key") @db.VarChar(500)
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  mediaType  String   @default("IMAGE") @map("media_type") @db.VarChar(20) // IMAGE | VIDEO | DOCUMENT | CERTIFICATE
  sizeBytes  Int?     @map("size_bytes")
  width      Int?
  height     Int?
  altText    String?  @map("alt_text") @db.VarChar(255)
  provider   String   @default("local") @db.VarChar(30) // local | azure_blob
  createdAt  DateTime @default(now()) @map("created_at")

  productMedia ProductMedia[]

  @@map("media_assets")
}

model ProductMedia {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String          @map("media_id") @db.Uuid
  media     MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  role      String          @default("GALLERY") @db.VarChar(20) // GALLERY | LIFESTYLE | 360 | THUMBNAIL
  sortOrder Int             @default(0) @map("sort_order")
  isPrimary Boolean         @default(false) @map("is_primary")
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@map("product_media")
}

// ── 4. PRODUCT_VARIANTS ──────────────────────────────────────────────────────
model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String   @db.VarChar(20)
  price     Decimal  @db.Decimal(10, 2)
  costPrice Decimal? @map("cost_price") @db.Decimal(10, 2)
  // Finance Phase 8: known-at-setup per-unit costs beyond purchase price —
  // packaging materials, label printing. Freight/courier/marketing are
  // period-level spend, not per-unit, so they're not modeled here — see
  // Expense + financeService.js allocatedOverheadPerUnit instead.
  packagingCost Decimal? @map("packaging_cost") @db.Decimal(10, 2)
  labellingCost Decimal? @map("labelling_cost") @db.Decimal(10, 2)
  sku       String   @unique @db.VarChar(100)
  barcode   String?  @db.VarChar(100)

  // NEW: Logistical Fields
  uom              String                  @default("ml") @db.VarChar(20)
  volume           Int                     @default(0)
  weightGrams      Int?                    @map("weight_grams")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  inventory        Inventory?
  inventoryLogs    InventoryLog[]
  orderItems       OrderItem[]
  purchaseItems    PurchaseItem[]
  quoteItems       QuoteItem[]
  reservations     InventoryReservation[]
  attributeValues  VariantAttributeValue[]
  media            ProductMedia[]
  exchangeRequests ExchangeRequest[]

  @@index([productId])
  @@map("product_variants")
}

// ── 5. INVENTORY ─────────────────────────────────────────────────────────────
model Inventory {
  id                String         @id @default(uuid()) @db.Uuid
  variantId         String         @unique @map("variant_id") @db.Uuid
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5) @map("low_stock_threshold")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@map("inventory")
}

// ── 5b. INVENTORY_RESERVATIONS ────────────────────────────────────────────────
// A hold placed on stock between order creation and payment confirmation.
// Prevents the oversell race: quantity is only decremented on payment; until
// then, `reserved` narrows what other checkouts see as available.
model InventoryReservation {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId    String         @map("order_id") @db.Uuid
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity   Int
  expiresAt  DateTime       @map("expires_at")
  consumedAt DateTime?      @map("consumed_at")
  releasedAt DateTime?      @map("released_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([variantId])
  @@index([orderId])
  @@index([expiresAt, consumedAt, releasedAt])
  @@map("inventory_reservations")
}

// ── 6. INVENTORY_LOGS ────────────────────────────────────────────────────────
model InventoryLog {
  id              String         @id @default(uuid()) @db.Uuid
  variantId       String         @map("variant_id") @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  changeType      String         @map("change_type") @db.VarChar(20) // add/remove/sale/return
  quantityChanged Int            @map("quantity_changed")
  reason          String?
  referenceId     String?        @map("reference_id") @db.Uuid // link to order/purchase
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@index([referenceId])
  @@map("inventory_logs")
}

// ── 7. CUSTOMERS ─────────────────────────────────────────────────────────────
model Customer {
  id                      String    @id @default(uuid()) @db.Uuid
  name                    String?   @db.VarChar(100)
  email                   String?   @unique @db.VarChar(150)
  phone                   String?   @db.VarChar(20)
  // Nullable — guest checkouts still create a Customer row with no password.
  // Registering later with the same email attaches a password to this same
  // row rather than creating a duplicate, so prior guest orders are inherited.
  passwordHash            String?   @map("password_hash")
  passwordResetToken      String?   @unique @map("password_reset_token")
  passwordResetExpiresAt  DateTime? @map("password_reset_expires_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  addresses               Address[]
  orders                  Order[]
  quotes                  Quote[]

  @@map("customers")
}

// ── 8. ADDRESSES ─────────────────────────────────────────────────────────────
model Address {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street         String?
  city           String?  @db.VarChar(100)
  province       String?  @db.VarChar(100)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  country        String?  @db.VarChar(100)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  shippingOrders Order[]  @relation("OrderShippingAddress")
  billingOrders  Order[]  @relation("OrderBillingAddress")

  @@index([customerId])
  @@map("addresses")
}

// ── 9. ORDERS ────────────────────────────────────────────────────────────────
model Order {
  id                String    @id @default(uuid()) @db.Uuid
  // Human-readable sequential reference (e.g. "OSC-100548"), assigned from
  // the order_number_seq Postgres sequence at creation time — see
  // server/src/lib/orderNumberService.js. Distinct from `id` (UUID, internal).
  orderNumber       String    @unique @map("order_number") @db.VarChar(30)
  customerId        String?   @map("customer_id") @db.Uuid
  customer          Customer? @relation(fields: [customerId], references: [id])
  status            String    @default("pending") @db.VarChar(30)
  paymentStatus     String    @default("unpaid") @map("payment_status") @db.VarChar(30)
  totalAmount       Decimal   @map("total_amount") @db.Decimal(10, 2)
  shippingCost      Decimal   @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  shippingAddressId String?   @map("shipping_address_id") @db.Uuid
  shippingAddress   Address?  @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?   @map("billing_address_id") @db.Uuid
  billingAddress    Address?  @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])

  // Logistics Overhaul
  trackingNumber    String?          @map("tracking_number") @db.VarChar(100)
  courierName       String?          @map("courier_name") @db.VarChar(100)
  shippingStatus    String?          @map("shipping_status") @db.VarChar(50)
  shippedAt         DateTime?        @map("shipped_at")
  estimatedDelivery DateTime?        @map("estimated_delivery")
  logisticsEvents   LogisticsEvent[]

  // Quote Integration
  quoteId String? @unique @map("quote_id") @db.Uuid
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  // Pricing breakdown
  couponId       String?  @map("coupon_id") @db.Uuid
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxRateId      String?  @map("tax_rate_id") @db.Uuid
  taxRate        TaxRate? @relation(fields: [taxRateId], references: [id])
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(10, 2)

  notes              String?
  internalNotes      String?                @map("internal_notes")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  items              OrderItem[]
  payments           Payment[]
  invoices           Invoice[]
  reservations       InventoryReservation[]
  refunds            Refund[]
  paymentMilestones  PaymentMilestone[]
  abandonedEmailSent Boolean                @default(false) @map("abandoned_email_sent")

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

// ── 10. ORDER_ITEMS ──────────────────────────────────────────────────────────
model OrderItem {
  id              String           @id @default(uuid()) @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String?          @map("variant_id") @db.Uuid
  variant         ProductVariant?  @relation(fields: [variantId], references: [id])
  quantity        Int
  priceAtPurchase Decimal          @map("price_at_purchase") @db.Decimal(10, 2)
  returnItems     ReturnItem[]
  exchangeRequest ExchangeRequest?

  // PIM Phase 1: frozen at line-item creation so a renamed/deleted product or
  // variant never rewrites what a historical order/invoice was actually for.
  // Nullable so pre-existing rows fall back to the live relation unchanged.
  productNameSnapshot  String?  @map("product_name_snapshot")
  variantLabelSnapshot String?  @map("variant_label_snapshot")
  skuSnapshot          String?  @map("sku_snapshot")
  costAtPurchase       Decimal? @map("cost_at_purchase") @db.Decimal(10, 2)
  // Finance Phase 8: same snapshot-at-sale-time reasoning as costAtPurchase,
  // for ProductVariant.packagingCost/labellingCost.
  packagingCostAtPurchase Decimal? @map("packaging_cost_at_purchase") @db.Decimal(10, 2)
  labellingCostAtPurchase Decimal? @map("labelling_cost_at_purchase") @db.Decimal(10, 2)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ── 10b. RETURN_ITEMS ────────────────────────────────────────────────────────
// A customer return, inspected and dispositioned to one of two outcomes:
// good condition (restocked, ledgered via InventoryLog through adjustStock)
// or damaged (written off — no inventory change, this row is the only record).
model ReturnItem {
  id               String            @id @default(uuid()) @db.Uuid
  orderItemId      String            @map("order_item_id") @db.Uuid
  orderItem        OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity         Int
  condition        String            @db.VarChar(20) // GOOD | DAMAGED
  restocked        Boolean           @default(false)
  note             String?
  adminUserId      String?           @map("admin_user_id") @db.Uuid
  adminUser        AdminUser?        @relation(fields: [adminUserId], references: [id])
  createdAt        DateTime          @default(now()) @map("created_at")
  refunds          Refund[]
  exchangeRequests ExchangeRequest[]

  @@index([orderItemId])
  @@map("return_items")
}

// ── 11. PAYMENTS ─────────────────────────────────────────────────────────────
model Payment {
  id                   String            @id @default(uuid()) @db.Uuid
  orderId              String            @map("order_id") @db.Uuid
  order                Order             @relation(fields: [orderId], references: [id])
  paymentMethod        String?           @map("payment_method") @db.VarChar(50)
  paymentStatus        String?           @map("payment_status") @db.VarChar(30)
  transactionReference String?           @unique @map("transaction_reference") @db.VarChar(150)
  amount               Decimal?          @db.Decimal(10, 2)
  paidAt               DateTime?         @map("paid_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  milestone            PaymentMilestone?

  // ── Manual EFT verification (only set when paymentMethod = 'manual_eft') ──
  // One Payment row per EFT order, updated in place as proof is uploaded,
  // replaced, verified, or rejected — see server/src/lib/eftPaymentService.js.
  eftVerificationStatus String?              @map("eft_verification_status") @db.VarChar(20) // PENDING_PROOF, PROOF_UPLOADED, VERIFIED, REJECTED
  proofOfPaymentUrl      String?             @map("proof_of_payment_url")
  proofFileName          String?             @map("proof_file_name") @db.VarChar(255)
  proofFileSize          Int?                @map("proof_file_size")
  proofMimeType          String?             @map("proof_mime_type") @db.VarChar(100)
  proofUploadedAt        DateTime?           @map("proof_uploaded_at")
  verifiedByAdminId      String?             @map("verified_by_admin_id") @db.Uuid
  verifiedByAdmin        AdminUser?          @relation(fields: [verifiedByAdminId], references: [id])
  verifiedAt             DateTime?           @map("verified_at")
  rejectionReason        String?             @map("rejection_reason")
  statusHistory          PaymentStatusHistory[]

  @@index([orderId])
  @@index([eftVerificationStatus])
  @@map("payments")
}

// ── 33. PAYMENT_STATUS_HISTORY ───────────────────────────────────────────────
// Timeline of EFT verification events, written by the customer (upload) and
// admin (verify/reject) actions — powers both the customer-facing order
// timeline and the admin verification queue's history. Kept separate from
// AuditLog, which stays the admin-wide operational log (still written
// alongside this for every admin verify/reject action).
model PaymentStatusHistory {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status    String   @db.VarChar(20)
  note      String?
  actorType String   @map("actor_type") @db.VarChar(20) // system, customer, admin
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("payment_status_history")
}

// ── 12. INVOICES ─────────────────────────────────────────────────────────────
model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id])
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(100)
  issuedDate    DateTime @default(now()) @map("issued_date")
  pdfUrl        String?  @map("pdf_url")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("invoices")
}

// ── 13. COUPONS ──────────────────────────────────────────────────────────────
model Coupon {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique @db.VarChar(50)
  discountType String?   @map("discount_type") @db.VarChar(20)
  value        Decimal?  @db.Decimal(10, 2)
  expiryDate   DateTime? @map("expiry_date")
  usageLimit   Int?      @map("usage_limit")
  usedCount    Int       @default(0) @map("used_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  orders       Order[]

  @@map("coupons")
}

// ── 14. SUPPLIERS ────────────────────────────────────────────────────────────
model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(150)
  contactEmail     String?           @map("contact_email") @db.VarChar(150)
  phone            String?           @db.VarChar(20)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  purchases        Purchase[]
  products         Product[]
  productSuppliers ProductSupplier[]

  @@map("suppliers")
}

// ── 14b. PRODUCT_SUPPLIERS ────────────────────────────────────────────────────
// Alternative suppliers for a product. Product.supplierId remains the
// fast-path primary supplier for the common single-supplier case; this table
// is purely additive for products that need alternates.
model ProductSupplier {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String   @map("supplier_id") @db.Uuid
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku  String?  @map("supplier_sku") @db.VarChar(100)
  leadTimeDays Int?     @map("lead_time_days")
  minOrderQty  Int?     @map("min_order_qty")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// ── 15. PURCHASES ────────────────────────────────────────────────────────────
model Purchase {
  id               String            @id @default(uuid()) @db.Uuid
  supplierId       String?           @map("supplier_id") @db.Uuid
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  totalCost        Decimal?          @map("total_cost") @db.Decimal(10, 2)
  status           String            @default("PENDING") @db.VarChar(30)
  // Finance Phase 2: AP settlement status, mirrors Order.paymentStatus.
  paymentStatus    String            @default("unpaid") @map("payment_status") @db.VarChar(30)
  // Finance Phase 4: VAT portion of totalCost, extracted (not added) at
  // receive time — see accountingService.js postPurchaseReceivedJournal.
  taxAmount        Decimal           @default(0) @map("tax_amount") @db.Decimal(10, 2)
  expectedDelivery DateTime?         @map("expected_delivery")
  receivedAt       DateTime?         @map("received_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  items            PurchaseItem[]
  payments         SupplierPayment[]

  @@map("purchases")
}

// ── 38. SUPPLIER_PAYMENTS ────────────────────────────────────────────────────
// Finance Phase 2: AP settlement against a received Purchase — mirrors
// Payment's shape on the payable side. See accountingService.js
// postSupplierPaymentJournal / supplierService.js payPurchase.
model SupplierPayment {
  id          String     @id @default(uuid()) @db.Uuid
  purchaseId  String     @map("purchase_id") @db.Uuid
  purchase    Purchase   @relation(fields: [purchaseId], references: [id])
  method      String     @db.VarChar(30)
  amount      Decimal    @db.Decimal(10, 2)
  reference   String?    @db.VarChar(150)
  notes       String?
  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  paidAt      DateTime   @default(now()) @map("paid_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([purchaseId])
  @@map("supplier_payments")
}

// ── 16. PURCHASE_ITEMS ───────────────────────────────────────────────────────
model PurchaseItem {
  id         String         @id @default(uuid()) @db.Uuid
  purchaseId String         @map("purchase_id") @db.Uuid
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String         @map("variant_id") @db.Uuid
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  costPrice  Decimal        @map("cost_price") @db.Decimal(10, 2)

  @@map("purchase_items")
}

// ── 17. NOTIFICATIONS ────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @db.VarChar(50)
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ── 18. AUDIT_LOGS ───────────────────────────────────────────────────────────
model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String     @db.VarChar(100)
  entity      String     @db.VarChar(50)
  entityId    String?    @map("entity_id") @db.Uuid
  details     Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([adminUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── 19. GLOBAL_SETTINGS ──────────────────────────────────────────────────────
model GlobalSetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(100)
  value String
  group String @default("general") @db.VarChar(50)

  @@map("global_settings")
}

// ── 20. CURRENCY_RATES ───────────────────────────────────────────────────────
model CurrencyRate {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(10) // USD, EUR, etc.
  rate       Decimal  @db.Decimal(18, 6) // Rate relative to ZAR baseline
  lastUpdate DateTime @default(now()) @map("last_update")

  @@map("currency_rates")
}

// ── 21. SHIPPING_ZONES ───────────────────────────────────────────────────────
model ShippingZone {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(100)
  country       String?  @db.VarChar(100)
  postalPattern String?  @map("postal_pattern") @db.VarChar(255)
  baseRate      Decimal  @map("base_rate") @db.Decimal(10, 2)
  freeAbove     Decimal? @map("free_above") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("shipping_zones")
}

// ── 22. LOGISTICS_EVENTS ─────────────────────────────────────────────────────
model LogisticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String   @db.VarChar(50) // PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED
  message   String?
  location  String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("logistics_events")
}

// ── 23. QUOTES ───────────────────────────────────────────────────────────────
model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  quoteNumber String      @unique @map("quote_number") @db.VarChar(100)
  customerId  String?     @map("customer_id") @db.Uuid
  customer    Customer?   @relation(fields: [customerId], references: [id])
  status      String      @default("draft") @db.VarChar(30) // draft, sent, approved, rejected, expired, converted
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  expiryDate  DateTime?   @map("expiry_date")
  notes       String?
  pdfUrl      String?     @map("pdf_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  items       QuoteItem[]
  order       Order?

  @@index([customerId, status])
  @@index([status, expiryDate])
  @@map("quotes")
}

// ── 24. QUOTE_ITEMS ──────────────────────────────────────────────────────────
model QuoteItem {
  id        String          @id @default(uuid()) @db.Uuid
  quoteId   String          @map("quote_id") @db.Uuid
  quote     Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity     Int
  priceAtQuote Decimal @map("price_at_quote") @db.Decimal(10, 2)

  // PIM Phase 1: see OrderItem — same snapshot rationale.
  productNameSnapshot  String? @map("product_name_snapshot")
  variantLabelSnapshot String? @map("variant_label_snapshot")
  skuSnapshot          String? @map("sku_snapshot")

  @@map("quote_items")
}

// ── 25. CATEGORIES ───────────────────────────────────────────────────────────
model Category {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique @db.VarChar(100)
  slug         String     @unique @db.VarChar(100)
  description  String?
  image        String?
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  parentId     String?    @map("parent_id") @db.Uuid
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  products     Product[]

  @@index([parentId, displayOrder])
  @@map("categories")
}

// ── 26. SUBSCRIBERS ──────────────────────────────────────────────────────────
model Subscriber {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(150)
  status           String    @default("active") @db.VarChar(20) // active | unsubscribed
  source           String    @default("frontend") @db.VarChar(50) // frontend | checkout | admin
  unsubscribeToken String?   @unique @map("unsubscribe_token") @db.VarChar(128)
  tokenExpiresAt   DateTime? @map("token_expires_at") // token TTL (90 days)
  addedBy          String?   @map("added_by") @db.VarChar(150) // admin name/id who created entry
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscribers")
}

// ── 27. NEWSLETTER_CAMPAIGNS ──────────────────────────────────────────────────
model NewsletterCampaign {
  id          String     @id @default(uuid()) @db.Uuid
  subject     String     @db.VarChar(200)
  contentHtml String     @map("content_html") @db.Text
  status      String     @default("draft") @db.VarChar(20) // draft, sent, failed
  sentAt      DateTime?  @map("sent_at")
  sentCount   Int        @default(0) @map("sent_count")
  attachments Json? // Store { filename, path, mimetype, size }
  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("newsletter_campaigns")
}

// ── 28. TAX_RATES ────────────────────────────────────────────────────────────
model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  rate      Decimal  @db.Decimal(5, 4) // e.g. 0.1500 = 15%
  region    String?  @db.VarChar(100)
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]

  @@map("tax_rates")
}

// ── 29. SHIPPING_METHODS ─────────────────────────────────────────────────────
// Admin-configurable replacement for the hardcoded COURIERS map in
// logisticsService.js — single source of truth for the fulfillment courier
// list (Order.courierName stays a plain string snapshot, unchanged, so
// existing orders/behavior are untouched).
model ShippingMethod {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique @db.VarChar(50)
  name                String   @db.VarChar(100)
  trackingUrlTemplate String?  @map("tracking_url_template")
  estimatedDays       Int?     @map("estimated_days")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("shipping_methods")
}

// ── 30. REFUNDS ──────────────────────────────────────────────────────────────
// A bookkeeping record of money returned to a customer — not a payment
// gateway integration (none exists for PayFast refunds today).
model Refund {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItemId String?     @map("return_item_id") @db.Uuid
  returnItem   ReturnItem? @relation(fields: [returnItemId], references: [id])
  amount       Decimal     @db.Decimal(10, 2)
  method       String      @db.VarChar(30) // eft, payfast_manual, store_credit, cash
  reference    String?     @db.VarChar(150)
  notes        String?
  adminUserId  String?     @map("admin_user_id") @db.Uuid
  adminUser    AdminUser?  @relation(fields: [adminUserId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([orderId])
  @@map("refunds")
}

// ── 31. EXCHANGE_REQUESTS ────────────────────────────────────────────────────
// A distinct "different size/scent" workflow: links a ReturnItem to a
// replacement OrderItem added to the SAME order (no parallel order created).
model ExchangeRequest {
  id                   String         @id @default(uuid()) @db.Uuid
  returnItemId         String         @map("return_item_id") @db.Uuid
  returnItem           ReturnItem     @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  replacementVariantId String         @map("replacement_variant_id") @db.Uuid
  replacementVariant   ProductVariant @relation(fields: [replacementVariantId], references: [id])
  newOrderItemId       String?        @unique @map("new_order_item_id") @db.Uuid
  newOrderItem         OrderItem?     @relation(fields: [newOrderItemId], references: [id])
  priceDifference      Decimal        @default(0) @map("price_difference") @db.Decimal(10, 2)
  status               String         @default("PENDING") @db.VarChar(20) // PENDING, COMPLETED
  createdAt            DateTime       @default(now()) @map("created_at")

  @@index([returnItemId])
  @@map("exchange_requests")
}

// ── 34. CHART_OF_ACCOUNTS ────────────────────────────────────────────────────
// Finance Phase 1: double-entry accounting core. The General Ledger (Journal +
// JournalLine) is the source of truth for money movement; Order/Payment/
// Invoice/Refund stay as-is and post journals rather than being replaced.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model ChartOfAccount {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique @db.VarChar(20)
  name          String          @db.VarChar(150)
  type          AccountType
  normalBalance NormalBalance   @map("normal_balance")
  parentId      String?         @map("parent_id") @db.Uuid
  parent        ChartOfAccount? @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      ChartOfAccount[] @relation("AccountTree")
  isActive      Boolean         @default(true) @map("is_active")
  isSystem      Boolean         @default(false) @map("is_system")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  journalLines  JournalLine[]

  @@index([type])
  @@map("chart_of_accounts")
}

// ── 35. JOURNALS ─────────────────────────────────────────────────────────────
// A posted, immutable double-entry. Corrections happen via a new reversing
// journal, never by editing/deleting an existing one — see accountingService.js.
enum JournalSourceType {
  ORDER_SALE
  ORDER_PAYMENT
  REFUND
  MANUAL
  PURCHASE_RECEIVE
  SUPPLIER_PAYMENT
  EXPENSE
  ASSET_ACQUISITION
  DEPRECIATION
  ASSET_DISPOSAL
}

model Journal {
  id              String            @id @default(uuid()) @db.Uuid
  // Sequential human-readable reference (e.g. "JNL-100001"), assigned from the
  // journal_number_seq Postgres sequence at posting time — see accountingService.js.
  journalNumber   String            @unique @map("journal_number") @db.VarChar(30)
  date            DateTime
  description     String
  sourceType      JournalSourceType @map("source_type")
  // Polymorphic reference to the Order/Payment/Refund that generated this
  // journal — no FK since it can point at different tables.
  sourceId        String?           @map("source_id") @db.Uuid
  postedByAdminId String?           @map("posted_by_admin_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  lines           JournalLine[]

  @@index([sourceType, sourceId])
  @@index([date])
  @@map("journals")
}

// ── 36. JOURNAL_LINES ────────────────────────────────────────────────────────
model JournalLine {
  id        String         @id @default(uuid()) @db.Uuid
  journalId String         @map("journal_id") @db.Uuid
  journal   Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId String         @map("account_id") @db.Uuid
  account   ChartOfAccount @relation(fields: [accountId], references: [id])
  debit     Decimal        @default(0) @db.Decimal(12, 2)
  credit    Decimal        @default(0) @db.Decimal(12, 2)
  memo      String?
  // Finance Phase 6: reciprocal side of BankTransaction.matchedJournalLineId —
  // lets "unmatched GL lines for this bank account" be a plain
  // `where: { matchedByBankTransaction: null }` filter.
  matchedByBankTransaction BankTransaction?

  @@index([accountId])
  @@index([journalId])
  @@map("journal_lines")
}

// ── 37. FISCAL_PERIODS ───────────────────────────────────────────────────────
// Auto-provisioned (OPEN) on first posting into a given month — no manual
// setup required to start posting. Posting into a CLOSED period is rejected.
enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

model FiscalPeriod {
  id        String             @id @default(uuid()) @db.Uuid
  label     String             @unique @db.VarChar(20) // e.g. "2026-08"
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")
  status    FiscalPeriodStatus @default(OPEN)
  createdAt DateTime           @default(now()) @map("created_at")

  @@map("fiscal_periods")
}

// ── 39. BANK_ACCOUNTS ────────────────────────────────────────────────────────
// Finance Phase 6: the GL-side representation of a real bank account, distinct
// from the customer-facing bank_* GlobalSetting keys used for EFT instructions
// (orders.js getPublicBankDetails) — this is for reconciliation, not display.
model BankAccount {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique @db.VarChar(150)
  bankName         String?           @map("bank_name") @db.VarChar(150)
  accountHolder    String?           @map("account_holder") @db.VarChar(150)
  accountNumber    String?           @map("account_number") @db.VarChar(100)
  branchCode       String?           @map("branch_code") @db.VarChar(50)
  accountType      String?           @map("account_type") @db.VarChar(50)
  swift            String?           @db.VarChar(50)
  // Links to ChartOfAccount.code (e.g. "1010") — no FK, mirrors the
  // accountCode-by-string convention accountingService.js already uses.
  chartAccountCode String            @map("chart_account_code") @db.VarChar(20)
  isDefault        Boolean           @default(false) @map("is_default")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  transactions     BankTransaction[]

  @@map("bank_accounts")
}

// ── 40. BANK_TRANSACTIONS ────────────────────────────────────────────────────
// One row per bank-statement line, entered manually. Reconciliation is
// matching these against JournalLines already posted to the same account —
// see bankingService.js.
model BankTransaction {
  id                   String       @id @default(uuid()) @db.Uuid
  bankAccountId        String       @map("bank_account_id") @db.Uuid
  bankAccount          BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date                 DateTime
  description          String
  // Signed: positive = money in, negative = money out — matches how a
  // statement line reads.
  amount               Decimal      @db.Decimal(12, 2)
  reference            String?      @db.VarChar(150)
  status               String       @default("UNMATCHED") @db.VarChar(20)
  matchedJournalLineId String?      @unique @map("matched_journal_line_id") @db.Uuid
  matchedJournalLine   JournalLine? @relation(fields: [matchedJournalLineId], references: [id])
  createdAt            DateTime     @default(now()) @map("created_at")

  @@index([bankAccountId, status])
  @@map("bank_transactions")
}

// ── 32. PAYMENT_MILESTONES ───────────────────────────────────────────────────
// Installment/deposit schedules for admin-created and quote-converted (B2B)
// orders only — not exposed on public retail checkout.
model PaymentMilestone {
  id        String    @id @default(uuid()) @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String    @db.VarChar(100)
  amountDue Decimal   @map("amount_due") @db.Decimal(10, 2)
  dueDate   DateTime? @map("due_date")
  status    String    @default("PENDING") @db.VarChar(20) // PENDING, PAID, OVERDUE
  paidAt    DateTime? @map("paid_at")
  paymentId String?   @unique @map("payment_id") @db.Uuid
  payment   Payment?  @relation(fields: [paymentId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payment_milestones")
}

// ── 41. EXPENSES ─────────────────────────────────────────────────────────────
// Finance Phase 8: gives the Phase 1-seeded EXPENSE chart accounts (Courier,
// Marketing, Packaging, etc.) an actual way to receive postings — see
// accountingService.js postExpenseJournal.
model Expense {
  id            String     @id @default(uuid()) @db.Uuid
  // Which EXPENSE-type ChartOfAccount this posts to — string code, no FK,
  // same accountCode-by-string convention accountingService.js already uses.
  accountCode   String     @map("account_code") @db.VarChar(20)
  amount        Decimal    @db.Decimal(10, 2)
  description   String
  date          DateTime   @default(now())
  paymentMethod String?    @map("payment_method") @db.VarChar(30)
  adminUserId   String?    @map("admin_user_id") @db.Uuid
  adminUser     AdminUser? @relation(fields: [adminUserId], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([accountCode, date])
  @@map("expenses")
}

// ── 42. ASSETS ───────────────────────────────────────────────────────────────
// Finance Phase 11: straight-line depreciation only — see
// accountingService.js postAssetAcquisitionJournal/postDepreciationJournal/
// postAssetDisposalJournal.
model Asset {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String              @db.VarChar(150)
  category            String?             @db.VarChar(100)
  purchaseDate        DateTime            @map("purchase_date")
  purchaseCost        Decimal             @map("purchase_cost") @db.Decimal(12, 2)
  salvageValue        Decimal             @default(0) @map("salvage_value") @db.Decimal(12, 2)
  usefulLifeMonths    Int                 @map("useful_life_months")
  status              String              @default("ACTIVE") @db.VarChar(20) // ACTIVE, DISPOSED
  disposalDate        DateTime?           @map("disposal_date")
  disposalProceeds    Decimal?            @map("disposal_proceeds") @db.Decimal(12, 2)
  adminUserId         String?             @map("admin_user_id") @db.Uuid
  adminUser           AdminUser?          @relation(fields: [adminUserId], references: [id])
  createdAt           DateTime            @default(now()) @map("created_at")
  depreciationEntries DepreciationEntry[]

  @@map("assets")
}

// ── 43. DEPRECIATION_ENTRIES ─────────────────────────────────────────────────
// One row per asset per period ("YYYY-MM") — the unique constraint is the
// idempotency guard against double-posting a month's depreciation.
model DepreciationEntry {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  period    String   @db.VarChar(20) // e.g. "2026-08"
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([assetId, period])
  @@map("depreciation_entries")
}

// ── 44. BUDGETS ──────────────────────────────────────────────────────────────
// One figure per account for the whole budget period (not monthly-granular)
// — see admin_budgets.js GET /:id/actual for the budget-vs-actual comparison.
model Budget {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(150)
  startDate DateTime     @map("start_date")
  endDate   DateTime     @map("end_date")
  status    String       @default("DRAFT") @db.VarChar(20) // DRAFT, ACTIVE
  createdAt DateTime     @default(now()) @map("created_at")
  lines     BudgetLine[]

  @@map("budgets")
}

// ── 45. BUDGET_LINES ─────────────────────────────────────────────────────────
model BudgetLine {
  id             String  @id @default(uuid()) @db.Uuid
  budgetId       String  @map("budget_id") @db.Uuid
  budget         Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountCode    String  @map("account_code") @db.VarChar(20)
  budgetedAmount Decimal @map("budgeted_amount") @db.Decimal(12, 2)

  @@unique([budgetId, accountCode])
  @@map("budget_lines")
}

// ── 46. APPROVAL_REQUESTS ────────────────────────────────────────────────────
// Finance Phase 11: gates high-value refunds behind a second admin's
// sign-off — see approvalService.js. requireAdmin has no permission-level
// hierarchy (every admin is equal), so "second admin" concretely means
// approvedById must differ from requestedById.
model ApprovalRequest {
  id            String     @id @default(uuid()) @db.Uuid
  entityType    String     @map("entity_type") @db.VarChar(30) // "REFUND"
  requestedById String     @map("requested_by_id") @db.Uuid
  requestedBy   AdminUser  @relation("ApprovalRequested", fields: [requestedById], references: [id])
  approvedById  String?    @map("approved_by_id") @db.Uuid
  approvedBy    AdminUser? @relation("ApprovalDecided", fields: [approvedById], references: [id])
  status        String     @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  payload       Json
  createdAt     DateTime   @default(now()) @map("created_at")
  decidedAt     DateTime?  @map("decided_at")

  @@index([status])
  @@map("approval_requests")
}
